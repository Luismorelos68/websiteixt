---
// Un capítulo del caso de éxito: el reto, cómo lo resuelve el sistema y los detalles, con sus pantallas en el slot.
// Por omisión, texto e imágenes van lado a lado; con `apilado`, las imágenes van debajo, a todo lo ancho.
import Icon from './Icon.astro';
import type { NombreIcono } from './Icon.astro';

interface Props {
  id: string;
  numero: string;
  icono: NombreIcono;
  etiqueta: string;
  titulo: string;
  reto: string;
  texto: string;
  puntos: readonly string[];
  tono?: 'claro' | 'oscuro';
  apilado?: boolean;
  /** Pone las imágenes a la izquierda en pantallas grandes. */
  invertido?: boolean;
}

const { id, numero, icono, etiqueta, titulo, reto, texto, puntos, tono = 'claro', apilado = false, invertido = false } = Astro.props;
const claro = tono === 'claro';
---
<article id={id} class="scroll-mt-20">
  <div class:list={['grid gap-10 lg:grid-cols-12 lg:gap-12', !apilado && 'items-center']}>
    <div class:list={[apilado ? 'grid gap-x-12 gap-y-6 lg:col-span-12 lg:grid-cols-2' : 'lg:col-span-5', invertido && 'lg:order-last']}>
      <div>
        <div class="flex items-center gap-3">
          <span class:list={['inline-flex rounded-xl p-2.5', claro ? 'bg-jade/15 text-jade-oscuro' : 'bg-jade/10 text-jade']}>
            <Icon name={icono} class="h-6 w-6" />
          </span>
          <p class:list={['font-mono text-xs uppercase tracking-[0.2em]', claro ? 'text-jade-oscuro' : 'text-jade']}>
            <span class="opacity-60">{numero} ·</span>
            {etiqueta}
          </p>
        </div>
        <h3 class:list={['mt-5 text-balance font-serif text-3xl font-bold md:text-4xl', claro ? 'text-obsidiana' : 'text-hueso']}>{titulo}</h3>
        <p
          class:list={[
            'mt-6 border-l-2 pl-4 leading-relaxed',
            claro ? 'border-jade-oscuro/40 text-obsidiana/70' : 'border-jade/50 text-hueso/65',
          ]}
        >
          <strong class:list={['font-semibold', claro ? 'text-obsidiana' : 'text-hueso']}>El reto.</strong>
          {reto}
        </p>
      </div>
      <div class:list={[apilado && 'lg:pt-14']}>
        <p class:list={['text-lg leading-relaxed', apilado ? '' : 'mt-6', claro ? 'text-obsidiana/80' : 'text-hueso/80']}>{texto}</p>
        {puntos.length > 0 && (
          <ul class="mt-6 space-y-3">
            {puntos.map((punto) => (
              <li class:list={['flex gap-3', claro ? 'text-obsidiana/80' : 'text-hueso/75']}>
                <span class:list={['mt-2.5 h-1.5 w-1.5 shrink-0 rounded-full', claro ? 'bg-jade-oscuro' : 'bg-jade']}></span>
                {punto}
              </li>
            ))}
          </ul>
        )}
      </div>
    </div>
    <div class:list={[apilado ? 'lg:col-span-12' : 'lg:col-span-7']}>
      <slot />
    </div>
  </div>
</article>
