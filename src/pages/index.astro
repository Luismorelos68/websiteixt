---
import Base from '../layouts/Base.astro';
import BrowserFrame from '../components/BrowserFrame.astro';
import CtaContacto from '../components/CtaContacto.astro';
import Icon from '../components/Icon.astro';
import PhoneFrame from '../components/PhoneFrame.astro';
import { base } from '../utils/base';
import dashboard from '../assets/hermes/dashboard.png';
import credito from '../assets/hermes/credito.png';
import solicitudLeida from '../assets/hermes/solicitud-leida.png';

const capacidades = [
  {
    icono: 'scan-text',
    titulo: 'Solicitudes con OCR\u00a0+\u00a0IA',
    texto: 'El gerente fotografía la credencial en campo; el sistema la lee, llena la solicitud y la valida.',
  },
  {
    icono: 'activity',
    titulo: 'Métricas en tiempo real',
    texto: 'Mora, cartera vigente y colocación por gerente al momento, contra la meta y con semáforo.',
  },
  {
    icono: 'calendar-check',
    titulo: 'Cobranza semanal',
    texto: 'Calendario de pagos de cada crédito: en tiempo, adelantado o pendiente, con multas e historial.',
  },
  {
    icono: 'users',
    titulo: 'Clientes y grupos',
    texto: 'Expedientes de cada emprendedora y de cada grupo, con alertas cuando falta información.',
  },
  {
    icono: 'scale',
    titulo: 'Reglas claras',
    texto: 'Las políticas de crédito viven en el sistema y se explican en pantalla, para que todos cuenten igual.',
  },
  {
    icono: 'puzzle',
    titulo: 'Módulos a la medida',
    texto: 'Cada módulo se adapta a cómo trabaja el cliente, y se suman módulos nuevos cuando hacen falta.',
  },
] as const;

const etapas = [
  {
    icono: 'eye',
    nombre: 'Ver',
    texto: 'Escuchamos, revisamos sus números y conocemos su operación antes de proponer nada.',
  },
  {
    icono: 'list-checks',
    nombre: 'Ordenar',
    texto: 'Ponemos en orden lo financiero: costos, márgenes y reglas claras. Es la base de todo lo demás.',
  },
  {
    icono: 'trending-up',
    nombre: 'Crecer',
    texto: 'Construimos el sistema por etapas, con entregas que su equipo usa y ajusta desde el principio.',
  },
  {
    icono: 'refresh-cw',
    nombre: 'Renovar',
    texto: 'Capacitamos, medimos y ajustamos. Cuando su negocio cambia, el sistema cambia con él.',
  },
] as const;

const formaDeTrabajo = [
  {
    icono: 'route',
    titulo: 'Seguimos el customer journey',
    texto: 'Diseñamos cada pantalla siguiendo el recorrido real de su cliente y de su equipo, del primer contacto al último pago.',
  },
  {
    icono: 'activity',
    titulo: 'Métricas en tiempo real',
    texto: 'Las cifras se actualizan al momento: no hay que esperar al cierre de mes para saber cómo va el negocio.',
  },
  {
    icono: 'puzzle',
    titulo: 'Módulos a la medida',
    texto: 'Cada módulo se adapta a las necesidades y a la forma de trabajar de su negocio.',
  },
  {
    icono: 'wallet',
    titulo: 'Costo por módulo, con plan de pagos',
    texto: 'Cotizamos por módulo, ya sea uno existente o uno nuevo, según lo que necesite. Lo paga con un plan de pagos y le emitimos factura.',
  },
  {
    icono: 'target',
    titulo: 'Resultados, no horas',
    texto: 'Trabajamos por resultados que lo dejen satisfecho, no por tiempo. Y cumplimos las fechas que acordamos.',
  },
  {
    icono: 'user-round-check',
    titulo: 'Trato directo',
    texto: 'Habla con quienes diseñan y construyen su solución, sin intermediarios.',
  },
] as const;

const metas = [
  { titulo: 'Claridad', texto: 'Que sepa cuánto cuesta realmente lo que vende y dónde gana o pierde.' },
  { titulo: 'Control', texto: 'Que su operación diaria no dependa de la memoria de nadie.' },
  { titulo: 'Autonomía', texto: 'Que su equipo opere y mejore sus sistemas sin depender de nosotros.' },
  { titulo: 'Crecimiento', texto: 'Que crezca sabiendo su margen, no a ciegas.' },
];

const valores = [
  {
    icono: 'eye',
    nombre: 'Saber ver',
    texto: 'Entendemos antes de proponer. Ixtlamatini es el que conoce porque vio, no porque le contaron.',
  },
  {
    icono: 'badge-check',
    nombre: 'Honestidad',
    texto: 'Si no podemos ayudar, se lo decimos. Y si el problema es de alguien más, le decimos de quién.',
  },
  {
    icono: 'compass',
    nombre: 'Independencia',
    texto: 'No recibimos comisiones de proveedores ni de instituciones financieras: recomendamos lo que le conviene a usted.',
  },
  {
    icono: 'lock',
    nombre: 'Confidencialidad',
    texto: 'Acuerdo firmado y su información tratada con estándares del sector financiero, conforme a la LFPDPPP.',
  },
  {
    icono: 'file-search',
    nombre: 'Transparencia',
    texto: 'Todo lo que entregamos está documentado y lo puede revisar un tercero.',
  },
  {
    icono: 'sprout',
    nombre: 'Crecer juntos',
    texto: 'Buscamos relaciones de largo plazo: su crecimiento es la medida de nuestro trabajo.',
  },
] as const;

const especialidades = [
  {
    icono: 'code',
    nombre: 'Tecnológica',
    descripcion: 'Software a la medida e integración de software de terceros, en la nube u on-premise: AWS, Azure y Google Cloud.',
    razon: 'Convierte una decisión en algo que ocurre todos los días sin que nadie tenga que acordarse.',
  },
  {
    icono: 'landmark',
    nombre: 'Financiera',
    descripcion: 'Automatización de la gestión financiera para PyMEs y FinOps para corporativos, con contabilidad y auditoría contable.',
    razon: 'Es la condición de entrada: un sistema sobre un negocio que no cierra sus números solo automatiza la pérdida.',
  },
  {
    icono: 'scale',
    nombre: 'Legal',
    descripcion: 'Derecho corporativo, contratos, confidencialidad, protección de datos y auditorías. Para personas: penal, laboral, administrativo y civil.',
    razon: 'Lo legal no se agrega al final: define el diseño desde el principio.',
  },
  {
    icono: 'graduation-cap',
    nombre: 'Capital humano',
    descripcion: 'Capacitación, desarrollo organizacional, administración de personal y procesos de talento.',
    razon: 'Los sistemas los operan personas: sin capacitación, un sistema es un gasto; con ella, un activo.',
  },
  {
    icono: 'heart-handshake',
    nombre: 'Psicológica',
    descripcion: 'Red de psicólogos con cédula, para empresas y para personas.',
    razon: 'Las decisiones de negocio las toman personas bajo presión, y en la empresa familiar lo personal y lo empresarial se mezclan.',
  },
] as const;
---

<Base>
  <!-- PORTADA -->
  <section class="trama-fondo relative overflow-hidden border-b border-white/5">
    <div class="pointer-events-none absolute -right-48 top-10 h-[34rem] w-[34rem] rounded-full bg-jade/10 blur-3xl" aria-hidden="true"></div>
    <div class="relative mx-auto grid max-w-6xl items-center gap-14 px-6 pb-24 pt-16 md:pt-24 lg:grid-cols-12 lg:gap-12">
      <div class="lg:col-span-6">
        <p class="eyebrow mb-6">Consultoría financiera · Software a la medida</p>
        <h1 class="text-balance font-serif text-5xl font-bold leading-[1.05] text-hueso md:text-6xl">
          Software que nace de entender sus números.
        </h1>
        <p class="mt-8 max-w-xl text-lg leading-relaxed text-hueso/80">
          Primero ordenamos las finanzas de su negocio; después construimos el sistema que las sostiene.
          <span class="text-jade">Y nos quedamos a su lado mientras crece.</span>
        </p>
        <div class="mt-10 flex flex-wrap items-center gap-4">
          <a href={`${base}/contacto/`} class="btn-primario">Agendar conversación</a>
          <a href={`${base}/casos/equifin/`} class="btn-secundario">
            Ver el caso EquiFin <Icon name="arrow-right" class="h-4 w-4" />
          </a>
        </div>
        <p class="mt-6 font-mono text-xs uppercase tracking-widest text-hueso/50">Primera conversación sin costo</p>
      </div>

      <div class="relative lg:col-span-6">
        <BrowserFrame
          src={dashboard}
          alt="Tablero de HERMES en versión de demostración: porcentaje de mora, créditos, emprendedoras, cartera vigente y colocación del mes (datos ficticios)."
          sizes="(min-width: 1152px) 552px, (min-width: 1024px) 48vw, 100vw"
          prioridad
        />
        <a
          href={`${base}/casos/equifin/`}
          class="absolute -bottom-5 left-5 inline-flex items-center gap-2 rounded-full border border-jade/30 bg-obsidiana/90 px-4 py-2 font-mono text-[11px] uppercase tracking-widest text-jade shadow-lg backdrop-blur transition hover:border-jade"
        >
          <span class="h-1.5 w-1.5 rounded-full bg-jade"></span> HERMES · en operación en EquiFin
        </a>
      </div>
    </div>
  </section>

  <!-- CASO EQUIFIN -->
  <section id="equifin" class="bg-hueso text-obsidiana">
    <div class="mx-auto max-w-6xl px-6 py-24">
      <div class="grid gap-12 lg:grid-cols-12">
        <div class="lg:col-span-5">
          <p class="eyebrow mb-4 text-jade-oscuro">Lo que hemos construido</p>
          <h2 class="text-balance font-serif text-4xl font-bold md:text-5xl">HERMES: la operación de EquiFin en un solo sistema.</h2>
          <p class="mt-6 text-lg leading-relaxed text-obsidiana/75">
            EquiFin otorga microcréditos individuales y grupales a emprendedoras y emprendedores. Con su equipo diseñamos y
            construimos HERMES, el sistema donde hoy administran todo el recorrido: de la solicitud en campo a la cobranza
            semanal.
          </p>
          <a
            href={`${base}/casos/equifin/`}
            class="mt-8 inline-flex items-center gap-2 font-mono text-sm uppercase tracking-wider text-jade-oscuro underline decoration-jade decoration-2 underline-offset-8 transition hover:text-obsidiana"
          >
            Conozca el caso completo <Icon name="arrow-right" class="h-4 w-4" />
          </a>
        </div>

        <div class="grid gap-4 sm:grid-cols-2 lg:col-span-7">
          {capacidades.map((c) => (
            <article class="rounded-2xl border border-obsidiana/10 bg-white p-6 shadow-sm">
              <span class="inline-flex rounded-xl bg-jade/15 p-2.5 text-jade-oscuro">
                <Icon name={c.icono} class="h-5 w-5" />
              </span>
              <h3 class="mt-4 font-serif text-xl font-bold">{c.titulo}</h3>
              <p class="mt-2 text-sm leading-relaxed text-obsidiana/70">{c.texto}</p>
            </article>
          ))}
        </div>
      </div>

      <div class="mt-16 grid items-center gap-10 md:grid-cols-12">
        <BrowserFrame
          src={credito}
          tono="claro"
          class="md:col-span-8"
          alt="Detalle de un crédito en HERMES con su calendario de pagos semanal, la política de cobranza y el historial del cliente (datos ficticios)."
          sizes="(min-width: 1152px) 720px, (min-width: 768px) 64vw, 100vw"
        />
        <PhoneFrame
          src={solicitudLeida}
          class="md:col-span-4"
          alt="Solicitud en el celular del gerente: la credencial se leyó con OCR e IA y los datos se validaron (datos ficticios)."
          pie="Solicitud en campo: la credencial se lee sola."
        />
      </div>
      <p class="mt-6 text-sm text-obsidiana/60">
        Pantallas de una versión de demostración, con la marca de IXT y datos ficticios: la información de EquiFin y de sus
        clientes es confidencial.
      </p>
    </div>
  </section>

  <!-- ACOMPAÑAMIENTO -->
  <section id="acompanamiento" class="trama-fondo border-b border-white/5">
    <div class="mx-auto max-w-6xl px-6 py-24">
      <p class="eyebrow mb-4">Acompañamiento personalizado</p>
      <h2 class="max-w-3xl text-balance font-serif text-4xl font-bold text-hueso md:text-5xl">
        No le entregamos un sistema y desaparecemos.
      </h2>
      <p class="mt-6 max-w-3xl text-lg leading-relaxed text-hueso/75">
        Cada negocio es distinto, así que cada proyecto también. Trabajamos a su lado y con su gente en cada etapa, de
        principio a fin. Y es un ciclo: cuando termina, vuelve a empezar.
      </p>

      <ol class="mt-16 grid gap-6 md:grid-cols-2 lg:grid-cols-4">
        {etapas.map((e, i) => (
          <li class="rounded-2xl border border-white/10 bg-black/30 p-7">
            <div class="flex items-center justify-between">
              <span class="font-mono text-xs text-jade/70">0{i + 1}</span>
              <Icon name={e.icono} class="h-6 w-6 text-jade" />
            </div>
            <h3 class="mt-5 font-serif text-3xl font-bold text-hueso">{e.nombre}</h3>
            <p class="mt-3 text-sm leading-relaxed text-hueso/70">{e.texto}</p>
          </li>
        ))}
      </ol>

      <div class="mt-8 rounded-2xl border border-jade/20 bg-jade/5 p-8">
        <h3 class="font-serif text-2xl font-bold text-hueso">Así trabajamos</h3>
        <div class="mt-8 grid gap-x-10 gap-y-8 md:grid-cols-2 lg:grid-cols-3">
          {formaDeTrabajo.map((f) => (
            <div class="flex gap-4">
              <Icon name={f.icono} class="mt-1 h-6 w-6 shrink-0 text-jade" />
              <div>
                <h4 class="font-serif text-lg font-bold text-hueso">{f.titulo}</h4>
                <p class="mt-1 text-sm leading-relaxed text-hueso/70">{f.texto}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- PROPÓSITO Y VALORES -->
  <section id="valores" class="bg-nieve text-obsidiana">
    <div class="mx-auto max-w-6xl px-6 py-24">
      <div class="grid gap-12 lg:grid-cols-12">
        <div class="lg:col-span-5">
          <p class="eyebrow mb-4 text-jade-oscuro">Lo que queremos lograr</p>
          <h2 class="text-balance font-serif text-4xl font-bold md:text-5xl">
            Que cada cliente decida con números claros y crezca sobre bases firmes.
          </h2>
        </div>
        <dl class="grid gap-8 sm:grid-cols-2 lg:col-span-7 lg:pt-2">
          {metas.map((m) => (
            <div class="border-t-2 border-jade-oscuro pt-4">
              <dt class="font-serif text-2xl font-bold">{m.titulo}</dt>
              <dd class="mt-2 leading-relaxed text-obsidiana/70">{m.texto}</dd>
            </div>
          ))}
        </dl>
      </div>

      <div class="mt-24">
        <p class="eyebrow mb-4 text-jade-oscuro">Nuestros valores</p>
        <h2 class="font-serif text-4xl font-bold md:text-5xl">Lo que no negociamos.</h2>
        <div class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
          {valores.map((v) => (
            <article class="rounded-2xl border border-obsidiana/10 bg-white p-7 shadow-sm">
              <Icon name={v.icono} class="h-6 w-6 text-jade-oscuro" />
              <h3 class="mt-4 font-serif text-xl font-bold">{v.nombre}</h3>
              <p class="mt-2 text-sm leading-relaxed text-obsidiana/70">{v.texto}</p>
            </article>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- ESPECIALIDADES -->
  <section id="especialidades" class="bg-obsidiana">
    <div class="mx-auto max-w-6xl px-6 py-24">
      <p class="eyebrow mb-4">Especialidades</p>
      <h2 class="max-w-3xl text-balance font-serif text-4xl font-bold text-hueso md:text-5xl">Cinco especialidades, un mismo equipo.</h2>
      <p class="mt-6 max-w-3xl text-lg leading-relaxed text-hueso/75">
        Los problemas de una empresa no respetan las fronteras de las profesiones: una rotación alta es un problema financiero
        antes que de capital humano, y un sistema que nadie usa es psicológico antes que técnico.
      </p>

      <div class="mt-14 grid gap-4 md:grid-cols-2 lg:grid-cols-3">
        {especialidades.map((e) => (
          <article class="rounded-2xl border border-white/10 bg-black/30 p-7 transition hover:border-jade/40">
            <Icon name={e.icono} class="h-7 w-7 text-jade" />
            <h3 class="mt-5 font-serif text-2xl font-bold text-hueso">{e.nombre}</h3>
            <p class="mt-3 text-sm leading-relaxed text-hueso/75">{e.descripcion}</p>
            <p class="mt-4 border-l-2 border-jade/40 pl-4 text-sm italic leading-relaxed text-hueso/60">{e.razon}</p>
          </article>
        ))}
        <a
          href={`${base}/contacto/`}
          class="group flex flex-col justify-between rounded-2xl border border-dashed border-jade/40 p-7 transition hover:border-jade hover:bg-jade/5"
        >
          <div>
            <p class="font-serif text-2xl font-bold text-hueso">¿No sabe por dónde empezar?</p>
            <p class="mt-3 text-sm leading-relaxed text-hueso/70">
              Cuéntenos qué está pasando y le decimos qué especialidad necesita primero.
            </p>
          </div>
          <span class="mt-8 inline-flex items-center gap-2 font-mono text-xs uppercase tracking-widest text-jade">
            Hablemos <Icon name="arrow-right" class="h-4 w-4 transition group-hover:translate-x-1" />
          </span>
        </a>
      </div>
    </div>
  </section>

  <CtaContacto />
</Base>
