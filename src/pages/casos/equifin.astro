---
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import BrowserFrame from '../../components/BrowserFrame.astro';
import CtaContacto from '../../components/CtaContacto.astro';
import Icon from '../../components/Icon.astro';
import PhoneFrame from '../../components/PhoneFrame.astro';
import dashboard from '../../assets/hermes/dashboard.png';
import gerentes from '../../assets/hermes/dashboard-gerentes.png';
import clientes from '../../assets/hermes/clientes.png';
import grupos from '../../assets/hermes/grupos.png';
import credito from '../../assets/hermes/credito.png';
import politica from '../../assets/hermes/politica.png';
import login from '../../assets/hermes/login.png';
import solicitudCredencial from '../../assets/hermes/solicitud-credencial.png';
import solicitudCurp from '../../assets/hermes/solicitud-curp.png';
import solicitudLeida from '../../assets/hermes/solicitud-leida.png';

const ficha = [
  { termino: 'Cliente', valor: 'EquiFin' },
  { termino: 'Sector', valor: 'Microfinanzas' },
  { termino: 'Qué hicimos', valor: 'Desarrollo a la medida, llenado inteligente con OCR + IA, reportes y acompañamiento' },
  { termino: 'Estado', valor: 'En producción y en mejora continua' },
];

const tamanoModulo = '(min-width: 1152px) 640px, (min-width: 1024px) 56vw, 100vw';

const puntosProspectos = [
  'Lectura automática de la credencial con OCR + IA: nombre, CURP, fecha de nacimiento y vigencia.',
  'La CURP se confirma carácter por carácter, con avisos para el cero y la O, el uno y la I.',
  'Antes de las fotos, se le lee el aviso de privacidad a la clienta y su consentimiento queda registrado.',
  'Detecta solicitudes repetidas y guarda las incompletas 7 días antes de cancelarlas solas.',
  'Los datos se comparan con reportes de otras instituciones; el crédito lo decide la oficina.',
];

const pasosSolicitud = [
  {
    src: solicitudCredencial,
    alt: 'Paso 1 de una solicitud en el celular: aviso de privacidad para la clienta y toma de fotos de la credencial (datos ficticios).',
    pie: '1 · Aviso a la clienta y foto de la credencial',
  },
  {
    src: solicitudCurp,
    alt: 'Confirmación de la CURP leída de la credencial, carácter por carácter (datos ficticios).',
    pie: '2 · La CURP se confirma carácter por carácter',
  },
  {
    src: solicitudLeida,
    alt: 'Credencial leída: nombre, CURP, fecha de nacimiento y vigencia, con los datos ya consultados (datos ficticios).',
    pie: '3 · Datos leídos y consultados',
  },
];

const modulos = [
  {
    icono: 'users',
    titulo: 'Clientes y grupos',
    texto:
      'Cada emprendedora tiene su expediente, con su gerente y el estatus de su crédito. Los grupos se administran igual, con sus integrantes y su historial.',
    puntos: [
      'Búsqueda por nombre, CURP o código.',
      'Alertas cuando a un expediente le falta información.',
      'Créditos individuales y grupales en el mismo sistema.',
    ],
    imagenes: [
      { src: clientes, alt: 'Lista de clientes en HERMES con código, nombre, CURP, gerente y estatus (datos ficticios).' },
      { src: grupos, alt: 'Lista de grupos en HERMES con integrantes, gerente y estatus del crédito grupal (datos ficticios).' },
    ],
  },
  {
    icono: 'calendar-check',
    titulo: 'Créditos y cobranza semanal',
    texto:
      'Cada crédito muestra su calendario semana a semana: qué se pagó a tiempo, qué se adelantó, qué falta y si hubo multa.',
    puntos: [
      'Cada pago registrado con fecha y hora.',
      'Historial de ciclos para decidir renovaciones.',
      'Semáforo de renovación en cada crédito.',
    ],
    imagenes: [
      {
        src: credito,
        alt: 'Detalle de un crédito en HERMES: calendario de pagos semanal, datos del crédito, política e historial del cliente (datos ficticios).',
      },
    ],
  },
  {
    icono: 'activity',
    titulo: 'Tablero en tiempo real',
    texto:
      'La fotografía de la cartera al momento: porcentaje de mora, cartera vigente, pago semanal y colocación del mes, por gerente y contra la meta.',
    puntos: [
      'Semáforo de mora: en meta, atención o fuera de meta.',
      'Metas con fecha de vigencia y cada cifra con su definición a la vista.',
      'Exportación a Excel y CSV, tablero de riesgo, renovaciones y reporte gerencial.',
    ],
    imagenes: [
      {
        src: gerentes,
        alt: 'Tabla de colocación por gerente en HERMES: porcentaje de mora, créditos, emprendedoras, mora, pagos en tiempo y cartera vigente (datos ficticios).',
      },
    ],
  },
] as const;

const forma = [
  {
    icono: 'landmark',
    titulo: 'Primero, los números',
    texto:
      'Cada cifra del tablero tiene una definición acordada con EquiFin —mora, cartera vigente, interés por cuota— y el sistema la muestra donde se usa.',
  },
  {
    icono: 'refresh-cw',
    titulo: 'Mejora continua',
    texto: 'HERMES cambia al ritmo de la operación: metas nuevas, reglas nuevas y reportes nuevos. Hoy va en su versión 2.45.',
  },
  {
    icono: 'messages-square',
    titulo: 'Cerca de quien lo usa',
    texto: 'Las mejoras salen del día a día de quienes cobran, autorizan y deciden.',
  },
  {
    icono: 'puzzle',
    titulo: 'Módulos a la medida',
    texto: 'Cada módulo se adaptó a cómo trabaja EquiFin, y los nuevos se suman cuando la operación los pide.',
  },
] as const;
---

<Base
  title="IXT · Caso EquiFin"
  imagen="og-equifin.jpg"
  imagenAlt="HERMES: del primer contacto al último pago. Solicitudes con OCR + IA, cobranza semanal y métricas en tiempo real."
  description="Cómo construimos HERMES, el sistema de microfinanzas de EquiFin: solicitudes con OCR + IA, clientes, grupos, cobranza semanal y métricas en tiempo real."
>
  <!-- PORTADA DEL CASO -->
  <section class="trama-fondo relative overflow-hidden border-b border-white/5">
    <div class="pointer-events-none absolute -left-40 top-0 h-[30rem] w-[30rem] rounded-full bg-jade/10 blur-3xl" aria-hidden="true"></div>
    <div class="relative mx-auto max-w-6xl px-6 pt-16 md:pt-24">
      <p class="eyebrow mb-6">Caso · Microfinanzas</p>
      <h1 class="max-w-4xl text-balance font-serif text-[2.6rem] font-bold leading-[1.05] text-hueso sm:text-5xl md:text-6xl">
        EquiFin: su operación de microcréditos en un solo sistema.
      </h1>
      <div class="mt-10 grid gap-10 lg:grid-cols-12">
        <div class="lg:col-span-7">
          <p class="text-lg leading-relaxed text-hueso/80">
            Junto con el equipo de EquiFin diseñamos y construimos <strong class="font-semibold text-hueso">HERMES</strong>, el
            sistema con el que hoy levantan solicitudes en campo, administran clientes y grupos, cobran cada semana y miden su
            cartera en tiempo real.
          </p>
          <a href="https://equifin.com.mx" target="_blank" rel="noopener" class="btn-secundario mt-8">
            equifin.com.mx <Icon name="arrow-up-right" class="h-4 w-4" />
          </a>
        </div>
        <dl class="grid grid-cols-2 gap-x-6 gap-y-6 text-sm lg:col-span-5">
          {ficha.map(({ termino, valor }) => (
            <div>
              <dt class="eyebrow mb-1.5">{termino}</dt>
              <dd class="leading-relaxed text-hueso/85">{valor}</dd>
            </div>
          ))}
        </dl>
      </div>
    </div>
    <div class="relative mx-auto max-w-6xl px-6 pb-20 pt-14">
      <BrowserFrame
        src={dashboard}
        alt="Tablero de HERMES: porcentaje de mora, créditos, emprendedoras, mora, cartera vigente, pago semanal y colocación del mes (datos ficticios)."
        sizes="(min-width: 1152px) 1104px, 100vw"
        prioridad
      />
    </div>
  </section>

  <!-- MÓDULOS -->
  <section class="bg-hueso text-obsidiana">
    <div class="mx-auto max-w-6xl px-6 py-24">
      <p class="eyebrow mb-4 text-jade-oscuro">Qué hace HERMES, paso a paso</p>
      <h2 class="max-w-3xl text-balance font-serif text-4xl font-bold md:text-5xl">Del primer contacto con la clienta a su último pago.</h2>
      <p class="mt-6 max-w-3xl text-lg leading-relaxed text-obsidiana/75">
        HERMES sigue el customer journey de cada clienta: desde que el gerente la visita por primera vez hasta su último pago y
        su siguiente renovación.
      </p>

      <div class="mt-16 space-y-24">
        <article>
          <div class="grid gap-10 lg:grid-cols-12 lg:gap-12">
            <div class="lg:col-span-6">
              <span class="inline-flex rounded-xl bg-jade/15 p-2.5 text-jade-oscuro">
                <Icon name="scan-text" class="h-6 w-6" />
              </span>
              <h3 class="mt-5 text-balance font-serif text-3xl font-bold">Seguimiento de prospectos con llenado inteligente</h3>
              <p class="mt-4 text-lg leading-relaxed text-obsidiana/75">
                El gerente levanta la solicitud en campo, desde su celular: fotografía la credencial y el sistema la lee con OCR e
                inteligencia artificial, llena los datos y los valida. Él solo confirma.
              </p>
            </div>
            <ul class="space-y-3 lg:col-span-6 lg:pt-16">
              {puntosProspectos.map((punto) => (
                <li class="flex gap-3 text-obsidiana/80">
                  <span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-jade-oscuro"></span>
                  {punto}
                </li>
              ))}
            </ul>
          </div>
          <div class="-mx-6 mt-12 flex snap-x snap-mandatory gap-6 overflow-x-auto px-6 pb-4 md:mx-0 md:grid md:grid-cols-3 md:gap-8 md:overflow-visible md:px-0 md:pb-0">
            {pasosSolicitud.map((paso) => (
              <PhoneFrame src={paso.src} alt={paso.alt} pie={paso.pie} class="w-[72%] shrink-0 snap-center md:w-auto" />
            ))}
          </div>
        </article>

        {modulos.map((m, i) => (
          <article class="grid items-center gap-10 lg:grid-cols-12 lg:gap-12">
            <div class:list={['lg:col-span-5', i % 2 === 1 && 'lg:order-last']}>
              <span class="inline-flex rounded-xl bg-jade/15 p-2.5 text-jade-oscuro">
                <Icon name={m.icono} class="h-6 w-6" />
              </span>
              <h3 class="mt-5 font-serif text-3xl font-bold">{m.titulo}</h3>
              <p class="mt-4 text-lg leading-relaxed text-obsidiana/75">{m.texto}</p>
              <ul class="mt-6 space-y-3">
                {m.puntos.map((punto) => (
                  <li class="flex gap-3 text-obsidiana/80">
                    <span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-jade-oscuro"></span>
                    {punto}
                  </li>
                ))}
              </ul>
            </div>
            <div class="space-y-5 lg:col-span-7">
              {m.imagenes.map((imagen) => (
                <BrowserFrame src={imagen.src} alt={imagen.alt} tono="claro" sizes={tamanoModulo} />
              ))}
            </div>
          </article>
        ))}

        <article class="grid items-center gap-10 lg:grid-cols-12 lg:gap-12">
          <div class="lg:col-span-5 lg:order-last">
            <span class="inline-flex rounded-xl bg-jade/15 p-2.5 text-jade-oscuro">
              <Icon name="scale" class="h-6 w-6" />
            </span>
            <h3 class="mt-5 font-serif text-3xl font-bold">Reglas del negocio, explicadas en pantalla</h3>
            <p class="mt-4 text-lg leading-relaxed text-obsidiana/75">
              Las políticas de crédito viven dentro del sistema y se explican donde se usan, para que dirección, gerentes y
              cobranza cuenten igual.
            </p>
            <ul class="mt-6 space-y-3">
              {['Contador de cuotas fuera de tiempo en cada crédito.', 'Política y semáforo de renovación, cada uno con su propia regla.', 'Definiciones con versión y fecha de vigencia.'].map((punto) => (
                <li class="flex gap-3 text-obsidiana/80">
                  <span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-jade-oscuro"></span>
                  {punto}
                </li>
              ))}
            </ul>
          </div>
          <div class="lg:col-span-7">
            <Image
              src={politica}
              alt="Tarjeta de HERMES que explica la política de cuotas fuera de tiempo de un crédito (datos ficticios)."
              widths={[480, 960]}
              sizes="(min-width: 640px) 480px, 100vw"
              format="webp"
              quality={80}
              loading="lazy"
              class="mx-auto block h-auto w-full max-w-[480px] rounded-xl shadow-2xl shadow-obsidiana/15"
            />
          </div>
        </article>
      </div>

      <p class="mt-20 text-sm text-obsidiana/60">
        Las pantallas de esta página son de una versión de demostración, con la marca de IXT y datos ficticios. La información
        de EquiFin y de sus clientes es confidencial.
      </p>
    </div>
  </section>

  <!-- CÓMO LO HICIMOS -->
  <section class="trama-fondo border-b border-white/5">
    <div class="mx-auto max-w-6xl px-6 py-24">
      <p class="eyebrow mb-4">Cómo lo hicimos</p>
      <h2 class="max-w-3xl text-balance font-serif text-4xl font-bold text-hueso md:text-5xl">
        Lo construimos con su equipo, no solo para su equipo.
      </h2>

      <div class="mt-14 grid gap-6 md:grid-cols-2 lg:grid-cols-4">
        {forma.map((f) => (
          <article class="rounded-2xl border border-white/10 bg-black/30 p-7">
            <Icon name={f.icono} class="h-6 w-6 text-jade" />
            <h3 class="mt-5 font-serif text-2xl font-bold text-hueso">{f.titulo}</h3>
            <p class="mt-3 text-sm leading-relaxed text-hueso/70">{f.texto}</p>
          </article>
        ))}
      </div>

      <div class="mt-20 grid items-center gap-10 lg:grid-cols-12 lg:gap-12">
        <div class="lg:col-span-7">
          <BrowserFrame
            src={login}
            alt="Pantalla de inicio de sesión de HERMES, con acceso por Google o con cuenta propia."
            sizes={tamanoModulo}
          />
        </div>
        <div class="lg:col-span-5">
          <Icon name="shield-check" class="h-7 w-7 text-jade" />
          <h3 class="mt-5 font-serif text-3xl font-bold text-hueso">Listo para el día a día</h3>
          <p class="mt-4 text-lg leading-relaxed text-hueso/75">
            Acceso con Google o con cuenta propia, desde la computadora o el celular.
          </p>
        </div>
      </div>
    </div>
  </section>

  <CtaContacto titulo="¿Su operación necesita algo así?" />
</Base>
