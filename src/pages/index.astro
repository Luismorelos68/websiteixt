---
import Base from '../layouts/Base.astro';
import BrowserFrame from '../components/BrowserFrame.astro';
import CtaContacto from '../components/CtaContacto.astro';
import Icon from '../components/Icon.astro';
import LogoIxt from '../components/LogoIxt.astro';
import PhoneFrame from '../components/PhoneFrame.astro';
import { base } from '../utils/base';
import { resultados, avisoConfidencialidad } from '../data/caso';
import dashboard from '../assets/hermes/dashboard.png';
import riesgo from '../assets/hermes/riesgo.png';
import abono from '../assets/hermes/abono.png';
import cashflow from '../assets/hermes/cashflow.png';

const etapas = [
  {
    icono: 'eye',
    nombre: 'Ver',
    texto: 'Escuchamos, revisamos sus números y conocemos su operación antes de proponer nada.',
  },
  {
    icono: 'list-checks',
    nombre: 'Ordenar',
    texto: 'Empezamos por su P&L y su flujo de efectivo; de ahí, costos, márgenes y reglas claras. Es la base de todo lo demás.',
  },
  {
    icono: 'trending-up',
    nombre: 'Crecer',
    texto: 'Ajustamos o integramos los sistemas que ya usa y construimos los que falten, por etapas y con entregas que su equipo usa desde el principio.',
  },
  {
    icono: 'refresh-cw',
    nombre: 'Renovar',
    texto: 'Capacitamos, medimos y ajustamos. Cuando su negocio cambia, el sistema cambia con él.',
  },
] as const;

const formaDeTrabajo = [
  {
    icono: 'route',
    titulo: 'Seguimos el customer journey',
    texto: 'Diseñamos cada pantalla siguiendo el recorrido real de su cliente y de su equipo, del primer contacto al último pago.',
  },
  {
    icono: 'activity',
    titulo: 'Monitoreo en tiempo real',
    texto: 'Tableros que se actualizan al momento y semáforos que avisan a tiempo: no hay que esperar al cierre de mes para saber cómo va el negocio.',
  },
  {
    icono: 'puzzle',
    titulo: 'Ajustamos, integramos o construimos',
    texto: 'No siempre hay que empezar de cero: ajustamos los sistemas que ya usa, los integramos entre sí o construimos módulos a la medida.',
  },
  {
    icono: 'wallet',
    titulo: 'Costo por módulo, con plan de pagos',
    texto: 'Cotizamos por módulo, ya sea uno existente o uno nuevo, según lo que necesite, y lo paga con un plan de pagos.',
  },
  {
    icono: 'file-check',
    titulo: 'Emitimos factura',
    texto: 'Le entregamos factura por nuestros servicios.',
  },
  {
    icono: 'target',
    titulo: 'Resultados, no horas',
    texto: 'Trabajamos por resultados que lo dejen satisfecho, no por tiempo. Y cumplimos las fechas que acordamos.',
  },
  {
    icono: 'user-round-check',
    titulo: 'Trato directo',
    texto: 'Habla con quienes diseñan y construyen su solución, sin intermediarios.',
  },
  {
    icono: 'lock',
    titulo: 'Seguridad y confidencialidad',
    texto: 'Sesiones controladas, bitácora de cambios y datos personales protegidos. Y no publicamos el nombre ni los datos de nuestros clientes.',
  },
  {
    icono: 'graduation-cap',
    titulo: 'Su equipo, capacitado',
    texto: 'Nadie se queda sin saber usar lo que construimos.',
  },
] as const;

const reportes = [
  {
    sigla: 'P&L',
    nombre: 'Estado de resultados',
    pregunta: '¿Su negocio gana o pierde dinero?',
    texto: 'Ingresos, costos y gastos del periodo: el margen real de lo que vende.',
    puntos: [
      'Precios con base en el costo real.',
      'Qué productos, clientes o sucursales dejan utilidad.',
      'La base para invertir, crecer o pedir financiamiento.',
    ],
  },
  {
    sigla: 'Cashflow',
    nombre: 'Flujo de efectivo',
    pregunta: '¿Tiene el dinero cuando lo necesita?',
    texto: 'Entradas y salidas de dinero, semana a semana: liquidez y días de operación.',
    puntos: [
      'Cuántos días puede operar con la caja de hoy.',
      'A dónde se va cada peso que entra.',
      'Cuánto puede crecer sin quedarse sin efectivo.',
    ],
  },
];

const metas = [
  { titulo: 'Claridad', texto: 'Que sepa cuánto cuesta realmente lo que vende y dónde gana o pierde.' },
  { titulo: 'Control', texto: 'Que su operación diaria no dependa de la memoria de nadie.' },
  { titulo: 'Autonomía', texto: 'Que su equipo opere y mejore sus sistemas sin depender de nosotros.' },
  { titulo: 'Crecimiento', texto: 'Que crezca sabiendo su margen, no a ciegas.' },
];

const nombre = [
  { palabra: 'ixtli', significado: 'el rostro, los ojos' },
  { palabra: 'tlamatini', significado: 'el que sabe' },
  { palabra: 'Ixtlamatini', significado: 'el que sabe con los ojos', destacado: true },
];

const valores = [
  {
    icono: 'lock',
    nombre: 'Confidencialidad',
    texto: 'Nuestros clientes cuidan su privacidad y nosotros también: no publicamos sus nombres ni sus datos, firmamos acuerdo de confidencialidad y tratamos su información conforme a la LFPDPPP.',
  },
  {
    icono: 'eye',
    nombre: 'Saber ver',
    texto: 'Entendemos antes de proponer: primero vemos su operación y sus números, y después le decimos qué haríamos.',
  },
  {
    icono: 'badge-check',
    nombre: 'Honestidad',
    texto: 'Si no podemos ayudar, se lo decimos. Y si el problema es de alguien más, le decimos de quién.',
  },
  {
    icono: 'compass',
    nombre: 'Independencia',
    texto: 'No recibimos comisiones de proveedores ni de instituciones financieras: recomendamos lo que le conviene a usted.',
  },
  {
    icono: 'file-search',
    nombre: 'Transparencia',
    texto: 'Todo lo que entregamos está documentado y lo puede revisar un tercero.',
  },
  {
    icono: 'sprout',
    nombre: 'Crecer juntos',
    texto: 'Buscamos relaciones de largo plazo: su crecimiento es la medida de nuestro trabajo.',
  },
] as const;

const especialidades = [
  {
    icono: 'code',
    nombre: 'Tecnológica',
    descripcion: 'Ajuste e integración de los sistemas que ya usa y, cuando hace falta, software a la medida: web y móvil, todo en uno, en la nube u on-premise (AWS, Azure y Google Cloud).',
    razon: 'Convierte una decisión en algo que ocurre todos los días sin que nadie tenga que acordarse.',
  },
  {
    icono: 'landmark',
    nombre: 'Financiera',
    descripcion: 'Empezamos por su P&L y su flujo de efectivo. Automatización de la gestión financiera para PyMEs y FinOps para corporativos, con contabilidad y auditoría contable.',
    razon: 'Es la condición de entrada: un sistema sobre un negocio que no cierra sus números solo automatiza la pérdida.',
  },
  {
    icono: 'scale',
    nombre: 'Legal',
    descripcion: 'Derecho corporativo, contratos, confidencialidad, protección de datos y auditorías. Para personas: penal, laboral, administrativo y civil.',
    razon: 'Lo legal no se agrega al final: define el diseño desde el principio.',
  },
  {
    icono: 'graduation-cap',
    nombre: 'Capital humano',
    descripcion: 'Capacitación, desarrollo organizacional, administración de personal y procesos de talento.',
    razon: 'Los sistemas los operan personas: sin capacitación, un sistema es un gasto; con ella, un activo.',
  },
] as const;
---

<Base>
  <!-- PORTADA -->
  <section class="trama-fondo relative overflow-hidden border-b border-white/5">
    <div class="pointer-events-none absolute -right-48 top-10 h-[34rem] w-[34rem] rounded-full bg-jade/10 blur-3xl" aria-hidden="true"></div>
    <div class="relative mx-auto grid max-w-6xl items-center gap-14 px-6 pb-24 pt-16 md:pt-24 lg:grid-cols-12 lg:gap-12">
      <div class="lg:col-span-6">
        <p class="eyebrow mb-6">Le acompañamos a crecer</p>
        <h1 class="text-balance font-serif text-5xl font-bold leading-[1.05] text-hueso md:text-6xl">
          Software que nace de entender sus números.
        </h1>
        <p class="mt-8 max-w-xl text-lg leading-relaxed text-hueso/80">
          <span class="text-hueso">Usted es el experto en su negocio; nosotros le acompañamos.</span> Primero ordenamos sus
          números; después ajustamos, integramos o construimos los sistemas que los sostienen.
          <span class="text-jade">Y nos quedamos a su lado mientras crece.</span>
        </p>
        <div class="mt-10 flex flex-wrap items-center gap-4">
          <a href={`${base}/contacto/`} class="btn-primario">Agendar conversación</a>
          <a href={`${base}/casos/microfinanciera/`} class="btn-secundario">
            Ver caso de éxito <Icon name="arrow-right" class="h-4 w-4" />
          </a>
        </div>
        <p class="mt-6 font-mono text-xs uppercase tracking-widest text-hueso/50">Primera conversación sin costo</p>
      </div>

      <div class="relative lg:col-span-6">
        <BrowserFrame
          src={dashboard}
          alt="Tablero de HERMES en versión de demostración: porcentaje de mora, créditos, emprendedoras, cartera vigente y colocación del mes (datos ficticios)."
          sizes="(min-width: 1152px) 552px, (min-width: 1024px) 48vw, 100vw"
          prioridad
        />
        <a
          href={`${base}/casos/microfinanciera/`}
          class="absolute -bottom-5 left-5 inline-flex items-center gap-2 rounded-full border border-jade/30 bg-obsidiana/90 px-4 py-2 font-mono text-[11px] uppercase tracking-widest text-jade shadow-lg backdrop-blur transition hover:border-jade"
        >
          <span class="h-1.5 w-1.5 rounded-full bg-jade"></span> Caso real · Microfinanciera
        </a>
      </div>
    </div>
  </section>

  <!-- NOSOTROS: NUESTRO NOMBRE Y NUESTROS VALORES -->
  <section id="nosotros" class="relative overflow-hidden bg-arena text-obsidiana">
    <div class="pointer-events-none absolute -right-40 -top-20 h-[32rem] w-[32rem] rounded-full bg-cal/80 blur-3xl" aria-hidden="true"></div>
    <div class="relative mx-auto max-w-6xl px-6 py-24">
      <div class="grid items-center gap-12 lg:grid-cols-12">
        <div class="lg:col-span-7">
          <p class="eyebrow mb-4 text-jade-oscuro">Nuestro nombre</p>
          <h2 class="text-balance font-serif text-4xl font-bold md:text-6xl">Ixtlamatini: el que sabe con los ojos.</h2>
          <p class="mt-8 text-lg leading-relaxed text-obsidiana/75">
            En náhuatl, <em class="font-semibold not-italic text-obsidiana">ixtli</em> es el rostro, los ojos, y un
            <em class="font-semibold not-italic text-obsidiana">tlamatini</em> es el que sabe. Ixtlamatini es el que conoce porque vio,
            no porque le contaron.
          </p>
          <p class="mt-5 text-lg leading-relaxed text-obsidiana/75">
            Así trabajamos: antes de proponer, nos sentamos con usted, conocemos su operación y revisamos sus números. Usted
            conoce su negocio mejor que nadie; nosotros lo conocemos porque lo vemos a su lado.
          </p>
          <p class="mt-8 border-l-4 border-jade-oscuro pl-5 font-serif text-2xl font-bold leading-snug">
            No le dejamos solo: le acompañamos antes, durante y después.
          </p>
        </div>
        <div class="lg:col-span-5">
          <div class="rounded-3xl border border-obsidiana/10 bg-white/80 p-8 shadow-xl shadow-obsidiana/5">
            <LogoIxt class="h-20 w-20 text-jade-oscuro" />
            <dl class="mt-8 space-y-4">
              {nombre.map((parte) => (
                <div class="flex items-baseline justify-between gap-4 border-b border-obsidiana/10 pb-4 last:border-0 last:pb-0">
                  <dt class:list={['font-serif text-2xl font-bold', parte.destacado && 'text-jade-oscuro']}>{parte.palabra}</dt>
                  <dd class="text-right text-obsidiana/70">{parte.significado}</dd>
                </div>
              ))}
            </dl>
            <p class="mt-8 font-mono text-xs uppercase tracking-widest text-jade-oscuro">Saber ver para crecer juntos</p>
          </div>
        </div>
      </div>

      <div id="valores" class="mt-24 scroll-mt-20">
        <p class="eyebrow mb-4 text-jade-oscuro">Nuestros valores</p>
        <h2 class="font-serif text-4xl font-bold md:text-5xl">Lo que no negociamos.</h2>
        <div class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
          {valores.map((v) => (
            <article class="rounded-2xl border border-obsidiana/10 bg-white p-7 shadow-sm">
              <Icon name={v.icono} class="h-6 w-6 text-jade-oscuro" />
              <h3 class="mt-4 font-serif text-xl font-bold">{v.nombre}</h3>
              <p class="mt-2 text-sm leading-relaxed text-obsidiana/70">{v.texto}</p>
            </article>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- CASO DE ÉXITO -->
  <section id="caso" class="bg-hueso text-obsidiana">
    <div class="mx-auto max-w-6xl px-6 py-24">
      <div class="grid gap-12 lg:grid-cols-12">
        <div class="lg:col-span-5">
          <p class="eyebrow mb-4 text-jade-oscuro">Caso de éxito · Microfinanciera</p>
          <h2 class="text-balance font-serif text-4xl font-bold md:text-5xl">Más eficiencia operativa para una microfinanciera.</h2>
          <p class="mt-6 text-lg leading-relaxed text-obsidiana/75">
            Nuestro cliente otorga microcréditos individuales y grupales a emprendedoras y emprendedores. Ellos son los
            expertos en microfinanzas; nosotros los acompañamos. Con su equipo construimos HERMES, una plataforma web y móvil,
            todo en uno, que sigue el recorrido de cada clienta, de la solicitud en campo al último pago, con cobranza oportuna,
            mensajes por WhatsApp, monitoreo en tiempo real, un dashboard de riesgo y seguridad en cada pantalla. Y próximamente,
            cobros por WhatsApp y con link de pago.
          </p>
          <div class="mt-8 flex gap-4 rounded-2xl border border-jade-oscuro/20 bg-white p-5">
            <Icon name="lock" class="mt-0.5 h-5 w-5 shrink-0 text-jade-oscuro" />
            <p class="text-sm leading-relaxed text-obsidiana/75">
              <strong class="font-semibold text-obsidiana">Su privacidad, primero.</strong>
              {avisoConfidencialidad}
            </p>
          </div>
          <a
            href={`${base}/casos/microfinanciera/`}
            class="mt-8 inline-flex items-center gap-2 font-mono text-sm uppercase tracking-wider text-jade-oscuro underline decoration-jade decoration-2 underline-offset-8 transition hover:text-obsidiana"
          >
            Conozca el caso completo <Icon name="arrow-right" class="h-4 w-4" />
          </a>
        </div>

        <div class="lg:col-span-7">
          <h3 class="eyebrow mb-4 text-jade-oscuro">Resultados en eficiencia operativa</h3>
          <div class="grid gap-4 sm:grid-cols-2">
            {resultados.map((r) => (
              <article class="rounded-2xl border border-obsidiana/10 bg-white p-6 shadow-sm">
                <span class="inline-flex rounded-xl bg-jade/15 p-2.5 text-jade-oscuro">
                  <Icon name={r.icono} class="h-5 w-5" />
                </span>
                <h4 class="mt-4 font-serif text-xl font-bold">{r.titulo}</h4>
                <p class="mt-2 text-sm leading-relaxed text-obsidiana/70">{r.texto}</p>
              </article>
            ))}
          </div>
        </div>
      </div>

      <div class="mt-16 grid items-center gap-10 md:grid-cols-12">
        <BrowserFrame
          src={riesgo}
          tono="claro"
          class="md:col-span-8"
          alt="Dashboard de riesgo de HERMES: porcentaje de mora, saldos de créditos y cuotas con atraso, cartera en jurídico y antigüedad del atraso (datos ficticios)."
          sizes="(min-width: 1152px) 720px, (min-width: 768px) 64vw, 100vw"
          pie="Dashboard de riesgo: cuánto está en riesgo hoy y qué tan viejo es el atraso."
        />
        <PhoneFrame
          src={abono}
          class="md:col-span-4"
          alt="Registro de un abono desde el celular del gerente: cuota con atraso, abono parcial, fecha y hora del pago (datos ficticios)."
          pie="Cobranza en campo: cada abono, con fecha y hora."
        />
      </div>
      <p class="mt-6 text-sm text-obsidiana/60">Versión de demostración, con la marca de IXT y datos ficticios.</p>
    </div>
  </section>

  <!-- ACOMPAÑAMIENTO -->
  <section id="acompanamiento" class="trama-fondo border-b border-white/5">
    <div class="mx-auto max-w-6xl px-6 py-24">
      <p class="eyebrow mb-4">Acompañamiento personalizado</p>
      <h2 class="max-w-3xl text-balance font-serif text-4xl font-bold text-hueso md:text-5xl">
        Usted es el experto. Nosotros le acompañamos.
      </h2>
      <p class="mt-6 max-w-3xl text-lg leading-relaxed text-hueso/75">
        Nadie conoce su negocio mejor que usted y su equipo. Nuestro trabajo es acompañarlos: escuchar, ordenar los números
        y ajustar o integrar los sistemas que ya usan, o construir los que falten. No le entregamos un sistema y
        desaparecemos: nos quedamos a su lado, en un ciclo que, cuando termina, vuelve a empezar.
      </p>

      <ol class="mt-16 grid gap-6 md:grid-cols-2 lg:grid-cols-4">
        {etapas.map((e, i) => (
          <li class="rounded-2xl border border-white/10 bg-black/30 p-7">
            <div class="flex items-center justify-between">
              <span class="font-mono text-xs text-jade/70">0{i + 1}</span>
              <Icon name={e.icono} class="h-6 w-6 text-jade" />
            </div>
            <h3 class="mt-5 font-serif text-3xl font-bold text-hueso">{e.nombre}</h3>
            <p class="mt-3 text-sm leading-relaxed text-hueso/70">{e.texto}</p>
          </li>
        ))}
      </ol>

      <div class="mt-8 rounded-2xl border border-jade/20 bg-jade/5 p-8">
        <h3 class="font-serif text-2xl font-bold text-hueso">Así trabajamos</h3>
        <div class="mt-8 grid gap-x-10 gap-y-8 md:grid-cols-2 lg:grid-cols-3">
          {formaDeTrabajo.map((f) => (
            <div class="flex gap-4">
              <Icon name={f.icono} class="mt-1 h-6 w-6 shrink-0 text-jade" />
              <div>
                <h4 class="font-serif text-lg font-bold text-hueso">{f.titulo}</h4>
                <p class="mt-1 text-sm leading-relaxed text-hueso/70">{f.texto}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- LO FINANCIERO, PRIMERO -->
  <section id="finanzas" class="bg-hueso text-obsidiana">
    <div class="mx-auto max-w-6xl px-6 py-24">
      <div class="grid gap-12 lg:grid-cols-12">
        <div class="lg:col-span-5">
          <p class="eyebrow mb-4 text-jade-oscuro">Lo financiero, primero</p>
          <h2 class="text-balance font-serif text-4xl font-bold md:text-5xl">Todo empieza con dos reportes: P&amp;L y flujo de efectivo.</h2>
          <p class="mt-6 text-lg leading-relaxed text-obsidiana/75">
            Antes de construir cualquier sistema, ponemos en orden los números. En lo financiero siempre empezamos por el estado
            de resultados (P&amp;L) y el flujo de efectivo (cashflow): juntos dicen si su negocio gana dinero y si tiene el
            dinero cuando lo necesita.
          </p>
        </div>
        <div class="grid gap-4 sm:grid-cols-2 lg:col-span-7">
          {reportes.map((r) => (
            <article class="rounded-2xl border border-obsidiana/10 bg-white p-7 shadow-sm">
              <p class="font-mono text-xs uppercase tracking-widest text-jade-oscuro">{r.sigla}</p>
              <h3 class="mt-2 font-serif text-2xl font-bold">{r.nombre}</h3>
              <p class="mt-4 font-semibold">{r.pregunta}</p>
              <p class="mt-2 text-sm leading-relaxed text-obsidiana/70">{r.texto}</p>
              <ul class="mt-5 space-y-2 border-t border-obsidiana/10 pt-5">
                {r.puntos.map((punto) => (
                  <li class="flex gap-3 text-sm text-obsidiana/80">
                    <span class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-jade-oscuro"></span>
                    {punto}
                  </li>
                ))}
              </ul>
            </article>
          ))}
        </div>
      </div>

      <blockquote class="mt-14 max-w-4xl border-l-4 border-jade-oscuro pl-6 font-serif text-2xl leading-snug md:text-3xl">
        Un negocio puede tener utilidades y quedarse sin efectivo, o pérdidas en papel y la caja sana. Por eso los leemos juntos.
      </blockquote>

      <div class="mt-14">
        <BrowserFrame
          src={cashflow}
          tono="claro"
          alt="Análisis de flujo de caja: liquidez, días de cobertura, semáforos de salud financiera y a dónde va cada $100 cobrados (datos ficticios)."
          sizes="(min-width: 1152px) 1104px, 100vw"
        />
        <p class="mt-4 text-sm text-obsidiana/60">
          Un análisis de flujo de caja como los que entregamos: semáforos de salud financiera, liquidez, días de cobertura y a
          dónde va cada peso cobrado. Versión de demostración con datos ficticios.
        </p>
      </div>
    </div>
  </section>

  <!-- ESPECIALIDADES -->
  <section id="especialidades" class="bg-obsidiana">
    <div class="mx-auto max-w-6xl px-6 py-24">
      <p class="eyebrow mb-4">Especialidades</p>
      <h2 class="max-w-3xl text-balance font-serif text-4xl font-bold text-hueso md:text-5xl">Cuatro especialidades, un mismo equipo.</h2>
      <p class="mt-6 max-w-3xl text-lg leading-relaxed text-hueso/75">
        Los problemas de una empresa no respetan las fronteras de las profesiones: una rotación alta es un problema financiero
        antes que de capital humano, y un sistema que nadie usa es de capacitación antes que técnico.
      </p>

      <div class="mt-14 grid gap-4 md:grid-cols-2">
        {especialidades.map((e) => (
          <article class="rounded-2xl border border-white/10 bg-black/30 p-7 transition hover:border-jade/40">
            <Icon name={e.icono} class="h-7 w-7 text-jade" />
            <h3 class="mt-5 font-serif text-2xl font-bold text-hueso">{e.nombre}</h3>
            <p class="mt-3 text-sm leading-relaxed text-hueso/75">{e.descripcion}</p>
            <p class="mt-4 border-l-2 border-jade/40 pl-4 text-sm italic leading-relaxed text-hueso/60">{e.razon}</p>
          </article>
        ))}
        <a
          href={`${base}/contacto/`}
          class="group flex flex-col justify-between gap-6 rounded-2xl border border-dashed border-jade/40 p-7 transition hover:border-jade hover:bg-jade/5 md:col-span-2 md:flex-row md:items-center"
        >
          <div>
            <p class="font-serif text-2xl font-bold text-hueso">¿No sabe por dónde empezar?</p>
            <p class="mt-3 text-sm leading-relaxed text-hueso/70">
              Cuéntenos qué está pasando y le decimos qué especialidad necesita primero.
            </p>
          </div>
          <span class="inline-flex shrink-0 items-center gap-2 font-mono text-xs uppercase tracking-widest text-jade">
            Hablemos <Icon name="arrow-right" class="h-4 w-4 transition group-hover:translate-x-1" />
          </span>
        </a>
      </div>
    </div>
  </section>

  <!-- LO QUE QUEREMOS LOGRAR -->
  <section id="metas" class="bg-nieve text-obsidiana">
    <div class="mx-auto max-w-6xl px-6 py-24">
      <div class="grid gap-12 lg:grid-cols-12">
        <div class="lg:col-span-5">
          <p class="eyebrow mb-4 text-jade-oscuro">Lo que queremos lograr</p>
          <h2 class="text-balance font-serif text-4xl font-bold md:text-5xl">
            Que cada cliente decida con números claros y crezca sobre bases firmes.
          </h2>
        </div>
        <dl class="grid gap-8 sm:grid-cols-2 lg:col-span-7 lg:pt-2">
          {metas.map((m) => (
            <div class="border-t-2 border-jade-oscuro pt-4">
              <dt class="font-serif text-2xl font-bold">{m.titulo}</dt>
              <dd class="mt-2 leading-relaxed text-obsidiana/70">{m.texto}</dd>
            </div>
          ))}
        </dl>
      </div>
    </div>
  </section>

  <CtaContacto />
</Base>
