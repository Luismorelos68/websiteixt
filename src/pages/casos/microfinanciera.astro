          pie="Mis sesiones abiertas: cada dispositivo, con su IP, su inicio y su última actividad."
        />
        <BrowserFrame
          src={grupoHistorial}
          tono="claro"
          sizes={tamanoMitad}
          alt="Historial de un grupo en HERMES: altas, bajas y cambio de gerente, cada uno con su fecha y el usuario que lo hizo (datos ficticios)."
          pie="La bitácora de un grupo: quién hizo cada cambio y cuándo."
        />
      </div>
    </div>
  </section>

  <!-- CÓMO LO HICIMOS -->
